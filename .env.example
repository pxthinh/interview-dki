# Copy to .env and adjust. Every value has a working default; docker compose up runs without this file.

# Host ports
APP_PORT=8080
DB_PORT=5432
WEB_PORT=3000
MAILPIT_UI_PORT=8025

# Email notifications to meeting participants.
# Default: Mailpit sink in compose (UI at :8025). For real Gmail SMTP set:
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SMTP_AUTH=true  MAIL_STARTTLS=true
#   MAIL_USERNAME=<gmail>  MAIL_PASSWORD=<app password>  MAIL_FROM=<gmail>
MAIL_ENABLED=true
MAIL_FROM=rooms@dki.local

# Auth
JWT_SECRET=change-me-change-me-change-me-change-me-32b
JWT_EXPIRATION=8h

# Seed admin/users/rooms on first start when the users table is empty
SEED_ENABLED=true

# Check-in / no-show: khong check-in trong CHECKIN_GRACE_MINUTES phut dau gio
# thi booking tu chuyen NO_SHOW va phong duoc nha. Cua so check-in mo truoc gio hop
# CHECKIN_EARLY_WINDOW_MINUTES phut.
CHECKIN_ENABLED=true
CHECKIN_GRACE_MINUTES=15
CHECKIN_EARLY_WINDOW_MINUTES=5
CHECKIN_SWEEP_INTERVAL_MS=60000

# Google Calendar sync (off by default; see README "Bật Google Calendar")
GOOGLE_CALENDAR_ENABLED=false
# Service account JSON key, mounted into the container at /secrets/google-sa.json
# -> put the file at ./secrets/google-sa.json
GOOGLE_CALENDAR_INVITE_BOOKER=false
GOOGLE_IMPERSONATE_USER=
